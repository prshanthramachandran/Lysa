#!/bin/bash
# Lysa launcher — starts the Python server and opens Chrome.
# This script lives at Lysa.app/Contents/MacOS/Lysa, three levels deep
# inside the project root that contains server.py.

set -u
URL="http://localhost:8050"
LOG="${TMPDIR:-/tmp}/lysa.log"

# Resolve the project root (3 levels up from this script).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd)"

# Sanity check: can we even see the project files?
# When launched via Finder/Launch Services, macOS may block access to
# files under ~/Documents, ~/Downloads, ~/Desktop unless the .app has
# been granted permission.
if [ ! -r "$PROJECT_DIR/server.py" ]; then
    osascript <<EOF
display alert "Lysa" message "Cannot read server.py.

macOS is blocking Lysa from reading files in this folder. Either:

• Open System Settings → Privacy & Security → Files and Folders, find Lysa, and grant access to the folder containing it.

• Or move the Lysa folder out of ~/Documents, ~/Downloads, or ~/Desktop (which are protected by macOS) — for example to ~/Lysa or ~/Apps/Lysa."
EOF
    exit 1
fi

cd "$PROJECT_DIR" || exit 1

# Server already running? Just open the browser and exit.
if curl -s -o /dev/null --max-time 1 "$URL"; then
    open -a "Google Chrome" "$URL" 2>/dev/null || open "$URL"
    exit 0
fi

# Find a Python that has Lysa's deps installed.
# Launch Services gives us a minimal PATH (no Homebrew, no Anaconda),
# so we have to search common install locations directly. Allow
# LYSA_PYTHON to override (point at a venv's python if needed).
find_python() {
    local candidates=()
    if [ -n "${LYSA_PYTHON:-}" ]; then candidates+=("$LYSA_PYTHON"); fi
    candidates+=(
        "$(command -v python3 2>/dev/null)"
        "$(command -v python  2>/dev/null)"
        "/opt/homebrew/bin/python3"
        "/opt/anaconda3/bin/python3"
        "$HOME/anaconda3/bin/python3"
        "$HOME/miniconda3/bin/python3"
        "$HOME/miniforge3/bin/python3"
        "/usr/local/bin/python3"
        "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"
    )
    for c in "${candidates[@]}"; do
        if [ -n "$c" ] && [ -x "$c" ]; then
            if "$c" -c "import fastapi, uvicorn, numpy, PIL" >/dev/null 2>&1; then
                echo "$c"; return 0
            fi
        fi
    done
    return 1
}

PY="$(find_python)"
if [ -z "$PY" ]; then
    osascript <<EOF
display alert "Lysa" message "Could not find a Python with Lysa's dependencies installed.

In a terminal, run:
    cd \"$PROJECT_DIR\"
    pip install -r requirements.txt

Then double-click Lysa again.

If you use a virtualenv or conda env, set LYSA_PYTHON to its python before launching:
    launchctl setenv LYSA_PYTHON /path/to/python"
EOF
    exit 1
fi

# Start the server in the background. Output goes to a log we can
# inspect if anything goes wrong.
"$PY" server.py >"$LOG" 2>&1 &
SERVER_PID=$!

# Wait up to 15 seconds for the server to start serving.
for _ in $(seq 1 30); do
    if curl -s -o /dev/null --max-time 1 "$URL"; then break; fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        # Server died — show the last few log lines if we can.
        TAIL="$(tail -8 "$LOG" 2>/dev/null | sed 's/"/\\"/g')"
        osascript <<EOF
display alert "Lysa" message "The server crashed during startup.

Python: $PY

Last log lines:
$TAIL

Full log: $LOG"
EOF
        exit 1
    fi
    sleep 0.5
done

# Open Chrome (preferred) or default browser.
open -a "Google Chrome" "$URL" 2>/dev/null || open "$URL"

# Stay alive while the server runs so the Lysa icon stays in the Dock and
# Cmd+Q (or right-click → Quit) cleanly terminates the server.
trap 'kill "$SERVER_PID" 2>/dev/null; exit 0' SIGTERM SIGINT
wait "$SERVER_PID"
